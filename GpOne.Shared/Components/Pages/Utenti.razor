@page "/utenti"
@using Microsoft.Data.SqlClient
@inject UtentiService Servizio
@inject AiSettingsStore AiStore
@inject UserSessionService Sessione

<PageTitle>Utenti</PageTitle>

<h1><span class="bi bi-person-gear me-2" aria-hidden="true"></span>Utenti</h1>

@if (!Sessione.IsInRole(UserSessionService.RuoloAmministratore))
{
    <div class="alert alert-warning">Sezione riservata agli amministratori.</div>
    return;
}

@if (messaggio is not null)
{
    <div class="alert @(esitoPositivo ? "alert-success" : "alert-danger")">@messaggio</div>
}

@if (inModifica is null)
{
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-primary" @onclick="() => Apri(new UtenteGestione())"><span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Nuovo utente</button>
        <input class="form-control" style="max-width: 280px;" placeholder="Cerca…" @bind="cerca" @bind:event="oninput" />
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Utente</th><th>Nome</th><th>Email</th><th>Ruoli</th><th>Gp-One AI</th><th>Stato</th><th>Ultimo accesso</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var utente in utenti.Where(Visibile))
            {
                <tr>
                    <td>@utente.Username</td>
                    <td>@($"{utente.Nome} {utente.Cognome}".Trim())</td>
                    <td class="small">@utente.Email</td>
                    <td class="small">@string.Join(", ", utente.Ruoli)</td>
                    <td class="small">@(configurazioniAi.FirstOrDefault(c => c.Id == utente.AiConfigurazioneId)?.Nome ?? "–")</td>
                    <td>
                        @if (!utente.Attivo)
                        {
                            <span class="badge text-bg-secondary">Disattivato</span>
                        }
                        else if (utente.Bloccato)
                        {
                            <span class="badge text-bg-danger">Bloccato</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Attivo</span>
                        }
                    </td>
                    <td class="small">@(utente.UltimoAccesso?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "–")</td>
                    <td class="text-end text-nowrap">
                        @if (utente.Bloccato)
                        {
                            <button class="btn btn-sm btn-outline-warning" title="Sblocca" @onclick="() => SbloccaAsync(utente)"><span class="bi bi-unlock" aria-hidden="true"></span></button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" title="Modifica" @onclick="() => Apri(utente)"><span class="bi bi-pencil" aria-hidden="true"></span></button>
                        <button class="btn btn-sm btn-outline-danger" title="Elimina" @onclick="() => EliminaAsync(utente)" disabled="@(utente.Id == Sessione.Utente?.Id)"><span class="bi bi-trash" aria-hidden="true"></span></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card" style="max-width: 760px;">
        <div class="card-body">
            <h2 class="h5 mb-3">@(inModifica.Id == 0 ? "Nuovo utente" : $"Modifica {inModifica.Username}")</h2>
            <div class="row g-2">
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Nome utente</label>
                    <input class="form-control" @bind="inModifica.Username" autocomplete="off" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Email</label>
                    <input type="email" class="form-control" @bind="inModifica.Email" autocomplete="off" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Nome</label>
                    <input class="form-control" @bind="inModifica.Nome" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Cognome</label>
                    <input class="form-control" @bind="inModifica.Cognome" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">@(inModifica.Id == 0 ? "Password" : "Nuova password (lasciare vuoto per non cambiarla)")</label>
                    <input type="password" class="form-control" @bind="password" autocomplete="new-password" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label small">Conferma password</label>
                    <input type="password" class="form-control" @bind="conferma" autocomplete="new-password" />
                </div>
            </div>
            <div class="form-check my-2">
                <input id="attivo" type="checkbox" class="form-check-input" @bind="inModifica.Attivo" />
                <label class="form-check-label" for="attivo">Utente attivo</label>
            </div>
            <div class="mb-3" style="max-width: 360px;">
                <label class="form-label small" for="aiUtente">Gp-One AI</label>
                <select id="aiUtente" class="form-select" value="@(inModifica.AiConfigurazioneId?.ToString() ?? "")"
                        @onchange="e => inModifica.AiConfigurazioneId = int.TryParse(e.Value?.ToString(), out var id) ? id : null">
                    <option value="">Non abilitato</option>
                    @foreach (var configurazione in configurazioniAi)
                    {
                        <option value="@configurazione.Id">@configurazione.Nome</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <span class="form-label d-block small">Ruoli</span>
                @foreach (var ruolo in ruoli)
                {
                    <label class="me-3">
                        <input type="checkbox" class="form-check-input me-1" checked="@inModifica.Ruoli.Contains(ruolo.Codice)"
                               @onchange="e => { inModifica.Ruoli.Remove(ruolo.Codice); if (e.Value is true) inModifica.Ruoli.Add(ruolo.Codice); }" />@ruolo.Codice
                    </label>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SalvaAsync" disabled="@isBusy">Salva</button>
                <button class="btn btn-link" @onclick="() => inModifica = null">Annulla</button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<UtenteGestione> utenti = [];
    private IReadOnlyList<RuoloGestione> ruoli = [];
    private IReadOnlyList<ConfigurazioneAi> configurazioniAi = [];
    private UtenteGestione? inModifica;
    private string? password;
    private string? conferma;
    private string cerca = string.Empty;
    private string? messaggio;
    private bool esitoPositivo;
    private bool isBusy;

    private bool Visibile(UtenteGestione utente) =>
        cerca.Length == 0
        || $"{utente.Username} {utente.Nome} {utente.Cognome} {utente.Email}".Contains(cerca, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (Sessione.IsInRole(UserSessionService.RuoloAmministratore))
            await EseguiAsync(CaricaAsync);
    }

    private async Task CaricaAsync()
    {
        utenti = await Servizio.UtentiAsync();
        ruoli = await Servizio.RuoliAsync();
        try
        {
            configurazioniAi = await AiStore.ElencoAsync();
        }
        catch (SqlException)
        {
            // Configurazioni AI non ancora disponibili (script 11)
            configurazioniAi = [];
        }
    }

    // Si modifica una copia: "Annulla" non tocca l'elenco
    private void Apri(UtenteGestione utente)
    {
        inModifica = new UtenteGestione
        {
            Id = utente.Id, Username = utente.Username, Email = utente.Email, Nome = utente.Nome, Cognome = utente.Cognome,
            Attivo = utente.Attivo, Ruoli = [.. utente.Ruoli], AiConfigurazioneId = utente.AiConfigurazioneId
        };
        password = conferma = null;
        messaggio = null;
    }

    private async Task SalvaAsync()
    {
        if (string.IsNullOrWhiteSpace(inModifica!.Username) || string.IsNullOrWhiteSpace(inModifica.Email))
        {
            (esitoPositivo, messaggio) = (false, "Indicare nome utente ed email.");
            return;
        }
        if (password != conferma)
        {
            (esitoPositivo, messaggio) = (false, "Le password non coincidono.");
            return;
        }
        await EseguiAsync(async () =>
        {
            await Servizio.SalvaUtenteAsync(inModifica, password);
            inModifica = null;
            await CaricaAsync();
            (esitoPositivo, messaggio) = (true, "Utente salvato.");
        });
    }

    private Task SbloccaAsync(UtenteGestione utente) => EseguiAsync(async () =>
    {
        await Servizio.SbloccaAsync(utente.Id);
        await CaricaAsync();
        (esitoPositivo, messaggio) = (true, $"Utente {utente.Username} sbloccato.");
    });

    private Task EliminaAsync(UtenteGestione utente) => EseguiAsync(async () =>
    {
        await Servizio.EliminaUtenteAsync(utente.Id);
        await CaricaAsync();
        (esitoPositivo, messaggio) = (true, $"Utente {utente.Username} eliminato.");
    });

    private async Task EseguiAsync(Func<Task> azione)
    {
        isBusy = true;
        try
        {
            await azione();
        }
        catch (Exception ex) when (ex is SqlException or InvalidOperationException)
        {
            (esitoPositivo, messaggio) = (false, ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
