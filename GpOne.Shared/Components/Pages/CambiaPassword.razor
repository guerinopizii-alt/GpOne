@page "/cambia-password"
@using System.ComponentModel.DataAnnotations
@using Microsoft.Data.SqlClient
@inject UserSessionService Sessione

<PageTitle>Cambia password</PageTitle>

<h1><span class="bi bi-key me-2" aria-hidden="true"></span>Cambia password</h1>

<div class="card" style="max-width: 480px;">
    <div class="card-body">
        <EditForm Model="model" OnValidSubmit="SalvaAsync" FormName="cambia-password">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="attuale">Password attuale</label>
                <InputText id="attuale" type="password" class="form-control" @bind-Value="model.Attuale" autocomplete="current-password" />
                <ValidationMessage For="() => model.Attuale" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="nuova">Nuova password</label>
                <InputText id="nuova" type="password" class="form-control" @bind-Value="model.Nuova" autocomplete="new-password" />
                <div class="form-text">Almeno 8 caratteri.</div>
                <ValidationMessage For="() => model.Nuova" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="conferma">Conferma nuova password</label>
                <InputText id="conferma" type="password" class="form-control" @bind-Value="model.Conferma" autocomplete="new-password" />
                <ValidationMessage For="() => model.Conferma" />
            </div>

            @if (messaggio is not null)
            {
                <div class="alert @(esitoPositivo ? "alert-success" : "alert-danger") small">@messaggio</div>
            }

            <button type="submit" class="btn btn-primary" disabled="@isBusy">
                @if (isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Salva
            </button>
        </EditForm>
    </div>
</div>

@code {
    private CambioPasswordModel model = new();
    private string? messaggio;
    private bool esitoPositivo;
    private bool isBusy;

    private async Task SalvaAsync()
    {
        messaggio = null;

        if (model.Nuova == model.Attuale)
        {
            esitoPositivo = false;
            messaggio = "La nuova password deve essere diversa da quella attuale.";
            return;
        }

        isBusy = true;
        try
        {
            var errore = await Sessione.CambiaPasswordAsync(model.Attuale, model.Nuova);
            esitoPositivo = errore is null;
            messaggio = errore ?? "Password aggiornata.";
            if (esitoPositivo)
                model = new CambioPasswordModel();
        }
        catch (SqlException)
        {
            esitoPositivo = false;
            messaggio = "Impossibile contattare il database. Riprovare più tardi.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private class CambioPasswordModel
    {
        [Required(ErrorMessage = "Indicare la password attuale.")]
        public string Attuale { get; set; } = string.Empty;

        [Required(ErrorMessage = "Indicare la nuova password.")]
        [MinLength(8, ErrorMessage = "La password deve contenere almeno 8 caratteri.")]
        public string Nuova { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confermare la nuova password.")]
        [Compare(nameof(Nuova), ErrorMessage = "Le password non coincidono.")]
        public string Conferma { get; set; } = string.Empty;
    }
}
