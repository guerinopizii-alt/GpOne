@inherits LayoutComponentBase
@implements IDisposable
@using GpOne.Services
@inject UserSessionService Sessione
@inject AiSettingsStore AiStore
@inject GpOneAiService Ai
@inject DatiAiService DatiAi
@inject NavigationManager Navigation

<div class="page @(menuChiuso ? "menu-chiuso" : null)">
    <div class="sidebar">
        @if (caricato)
        {
            <NavMenu />
        }
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button" class="btn btn-link toggle-menu me-auto" @onclick="() => menuChiuso = !menuChiuso"
                    title="@(menuChiuso ? "Mostra menu" : "Nascondi menu")">
                <span class="bi @(menuChiuso ? "bi-layout-sidebar" : "bi-layout-sidebar-inset")" aria-hidden="true"></span>
            </button>
            @if (Sessione.Utente is { } utente)
            {
                <span class="small">
                    <span class="bi bi-person-circle me-1" aria-hidden="true"></span>@utente.NomeCompleto
                    <span class="badge text-bg-light ms-1" title="Ambiente">@Sessione.Profilo</span>
                </span>
                <a class="btn btn-link btn-sm" href="cambia-password">Cambia password</a>
                <button class="btn btn-link btn-sm" @onclick="Sessione.Logout">Esci</button>
            }
        </div>

        <article class="content px-4">
            @if (Sessione.IsAuthenticated && caricato)
            {
                @Body
            }
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Configurazione AI dell'utente (abilitazione e motore) letta dal database prima di mostrare le pagine
    private bool caricato;

    protected override async Task OnInitializedAsync()
    {
        Sessione.Changed += OnSessionChanged;
        if (Sessione.IsAuthenticated)
        {
            await AiStore.CaricaAsync();
            _ = PreriscaldaAiAsync();
        }
        caricato = true;
    }

    /// <summary>
    /// In background, subito dopo l'accesso: carica il modello Ollama e la struttura delle tabelle abilitate,
    /// così la prima domanda a Gp-One AI è più rapida. Gli errori si ignorano: si ripresenteranno alla domanda.
    /// </summary>
    private async Task PreriscaldaAiAsync()
    {
        if (!AiStore.Abilitato || !AiStore.Correnti.Preavvio)
            return;
        var impostazioni = AiStore.Correnti;

        async Task Ignora(Func<Task> azione)
        {
            try { await azione(); } catch { }
        }

        await Task.WhenAll(
            Ignora(() => Ai.PreriscaldaAsync(impostazioni)),
            impostazioni.DatiLiberi ? Ignora(() => DatiAi.PreparaSchemaAsync()) : Task.CompletedTask);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Senza utente autenticato si torna alla schermata di accesso
        if (!Sessione.IsAuthenticated)
            Navigation.NavigateTo("login");
    }

    private bool menuChiuso;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sessione.Changed -= OnSessionChanged;
}
